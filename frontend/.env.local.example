# Copy to .env.local (gitignored) and adjust if the backend runs elsewhere.
# Defaults to http://127.0.0.1:8000 if unset — see src/lib/api.ts.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# WebSocket stream endpoint. Defaults to the REAL backend's WS /ws/stream
# (real replayed CIC-IDS2017 traffic, Ticket #9) at ws://127.0.0.1:8000/ws/stream
# if unset — see src/lib/useEventStream.ts. The Ticket #4 mock server
# (`npm run mock`, ws://127.0.0.1:8001/ws/stream) still exists but is
# opt-in only, as a reconnect-test fixture — no synthetic data may appear
# anywhere in the product. Point this at it explicitly if that's what you
# need to test:
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8001/ws/stream
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000/ws/stream
