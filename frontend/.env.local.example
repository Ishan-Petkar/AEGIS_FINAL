# Copy to .env.local (gitignored) and adjust if the backend runs elsewhere.
# Defaults to http://127.0.0.1:8000 if unset — see src/lib/api.ts.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# WebSocket stream endpoint (Ticket #4/#9/#12). Defaults to the mock server
# (`npm run mock`) at ws://127.0.0.1:8001/ws/stream if unset — see
# src/lib/useEventStream.ts. Point this at the real backend's /ws/stream
# once Ticket #9 ships and Ticket #12 swaps the mock out.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8001/ws/stream
