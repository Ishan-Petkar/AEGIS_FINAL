# AEGIS - Environment Variables
# ---------------------------------
# The core engine (src/) is configured entirely through `src/settings.py`
# and reads no environment variables — that file remains the source of
# truth for engine tuning (decay rates, thresholds, model hyperparameters).
#
# The variables below configure the Phase 5 backend only (backend/config.py,
# BackendSettings / BACKEND_SETTINGS). They are LOCAL-DEVELOPMENT-ONLY
# credentials matching the Postgres role/database provisioned for this
# project (role "aegis", password "aegis", database "aegis"). Copy this
# file to `.env` (gitignored) and adjust for your environment; never commit
# real secrets or production credentials here or in `.env`.

# --- Database: connection components (used unless AEGIS_DATABASE_URL is set) ---
AEGIS_DB_HOST=127.0.0.1
AEGIS_DB_PORT=5432
AEGIS_DB_USER=aegis
AEGIS_DB_PASSWORD=aegis
AEGIS_DB_NAME=aegis

# --- Database: connection pool ---
AEGIS_DB_POOL_SIZE=5
AEGIS_DB_MAX_OVERFLOW=10
AEGIS_DB_POOL_TIMEOUT_SEC=30.0
AEGIS_DB_POOL_PRE_PING=true

# --- Database: single-URL override (escape hatch) ---
# When set, this takes precedence over all AEGIS_DB_* fields above.
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis:aegis@127.0.0.1:5432/aegis

# --- API server ---
# 127.0.0.1 (loopback only) is deliberate: the Phase 5 API/WebSocket have no
# authentication, so binding 0.0.0.0 exposes unauthenticated replay/inject
# control to every device on the network (e.g. hackathon venue wifi). Only
# change this if you specifically need container networking or to demo from
# another device on a trusted network.
AEGIS_API_HOST=127.0.0.1
AEGIS_API_PORT=8000

# --- Replay ---
AEGIS_REPLAY_SPEED=20.0
# friday-morning: 1.03% real Bot/C2 traffic against a benign background —
# the realistic operational mix for the landing stream (P5-8). Monday is
# 0.0% attacks (see AEGIS_WARMUP_DATASET_DAY below); Friday-afternoon files
# run 55-57% attacks, unrealistically hostile for a demo.
AEGIS_REPLAY_DEFAULT_DATASET_DAY=friday-morning
# monday: genuine second-resolution, all-benign baseline used only to fit
# StreamingScorer during warmup (Ticket #5) — never the landing stream.
AEGIS_WARMUP_DATASET_DAY=monday

# --- Model artifact (Ticket #5) ---
AEGIS_MODEL_ARTIFACT_PATH=artifacts/streaming_scorer.joblib
