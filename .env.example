# AEGIS V2 - Environment Variables
# ---------------------------------
# Currently, this project is configured entirely through `src/settings.py`
# and does not require external API keys, database credentials, or secret tokens.
#
# If you add external integrations (e.g., cloud databases, AI APIs), 
# place the placeholder variable names here. Do NOT commit actual secrets.

# EXAMPLE_API_KEY=your_key_here
# DATABASE_URL=postgresql://user:pass@localhost:5432/dbname
