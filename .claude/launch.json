{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aegis-dashboard",
      "runtimeExecutable": "venv/bin/streamlit",
      "runtimeArgs": ["run", "src/aegis_demo.py", "--server.headless=true", "--server.port=8501"],
      "port": 8501
    },
    {
      "name": "aegis-console",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "aegis-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "PYTHONPATH=src venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    }
  ]
}
